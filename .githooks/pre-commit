#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

run_rust_checks=false
run_portal_checks=false
run_worker_checks=false
run_hook_checks=false
portal_dependencies_changed=false
worker_dependencies_changed=false
staged_paths_file="$(mktemp)"

cleanup_staged_paths() {
  rm -f -- "$staged_paths_file"
}
trap cleanup_staged_paths EXIT

git diff --cached --name-only --no-renames -z >"$staged_paths_file"

while IFS= read -r -d '' staged_path; do
  case "$staged_path" in
    assets/icons/kubernetes-dev-ui.svg | crates/components/assets/icons/* | crates/components/assets/fonts/* | crates/components/tests/snapshots/buttons/test_button_interaction_states/* | crates/components/tests/snapshots/comboboxes/test_combobox_flow/closed.png | crates/components/tests/snapshots/showcase/showcase_buttons/buttons.png | crates/components/tests/snapshots/text_inputs/snapshots_empty_filled_and_focused_inputs/*)
      run_rust_checks=true
      run_portal_checks=true
      ;;
    Cargo.toml | Cargo.lock | rust-toolchain.toml | .config/nextest.toml | crates/* | assets/* | scripts/ensure-kind-cluster.sh | scripts/kind-metrics-server.yaml)
      run_rust_checks=true
      ;;
    licensing/portal/*)
      run_portal_checks=true
      case "$staged_path" in
        licensing/portal/package.json | licensing/portal/package-lock.json)
          portal_dependencies_changed=true
          ;;
      esac
      ;;
    licensing/worker/*)
      run_worker_checks=true
      case "$staged_path" in
        licensing/worker/package.json | licensing/worker/package-lock.json)
          worker_dependencies_changed=true
          ;;
      esac
      ;;
    licensing/protocol-fixtures/*)
      run_rust_checks=true
      run_worker_checks=true
      ;;
    flake.nix | flake.lock)
      run_rust_checks=true
      run_portal_checks=true
      run_worker_checks=true
      ;;
    .github/workflows/licensing.yml)
      run_portal_checks=true
      run_worker_checks=true
      ;;
    .github/workflows/release.yml)
      run_rust_checks=true
      ;;
    .githooks/pre-commit | scripts/test-pre-commit.sh)
      run_hook_checks=true
      ;;
  esac
done <"$staged_paths_file"

cleanup_staged_paths
trap - EXIT

selected_checks=()
$run_hook_checks && selected_checks+=("hook")
$run_rust_checks && selected_checks+=("Rust desktop")
$run_portal_checks && selected_checks+=("licensing frontend")
$run_worker_checks && selected_checks+=("licensing worker")

if ((${#selected_checks[@]} == 0)); then
  echo "Pre-commit: no application checks are required for the staged files."
  exit 0
fi

printf 'Pre-commit checks:'
printf ' %s' "${selected_checks[@]}"
printf '\n'

if $run_hook_checks; then
  bash scripts/test-pre-commit.sh
fi

if $run_rust_checks; then
  cargo fmt --check
  cargo clippy --workspace --all-targets --all-features -- -D warnings
  cargo nextest run --workspace
fi

if $run_portal_checks; then
  (
    cd licensing/portal
    if $portal_dependencies_changed || [[ ! -d node_modules ]]; then
      npm ci
    fi
    npm test
  )
fi

if $run_worker_checks; then
  (
    cd licensing/worker
    if $worker_dependencies_changed || [[ ! -d node_modules ]]; then
      npm ci
    fi
    npm run check
    npm test
  )
fi
