# Reusable, GitHub Actions-like Linux test image. Rebuild intentionally when the
# pinned Ubuntu digest, Rust toolchain, or cargo-nextest version changes.
FROM docker.io/library/ubuntu:24.04@sha256:019e8eb29a85e74d64925745884f2ec79aa27e3feab36353d24656f4d6b89467

ARG CARGO_NEXTEST_VERSION=0.9.140
ARG RUSTUP_INIT_VERSION=1.29.0
ARG RUSTUP_INIT_SHA256=4acc9acc76d5079515b46346a485974457b5a79893cfb01112423c89aeb5aa10

ENV DEBIAN_FRONTEND=noninteractive
ENV CARGO_HOME=/opt/cargo
ENV CARGO_TARGET_DIR=/opt/styrhous-target
ENV RUSTUP_HOME=/opt/rustup
ENV PATH=/opt/cargo/bin:${PATH}

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        git \
        libegl1 \
        libgl1-mesa-dri \
        libssl-dev \
        pkg-config \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 1000 --non-unique styrhous \
    && useradd --create-home --uid 1000 --gid styrhous --non-unique styrhous \
    && install --directory --owner styrhous --group styrhous \
        "${CARGO_HOME}" "${CARGO_TARGET_DIR}" "${RUSTUP_HOME}"

WORKDIR /workspace

USER styrhous

COPY --chown=styrhous:styrhous rust-toolchain.toml ./

RUN curl --proto '=https' --tlsv1.2 --silent --show-error --fail \
        --output /tmp/rustup-init \
        "https://static.rust-lang.org/rustup/archive/${RUSTUP_INIT_VERSION}/x86_64-unknown-linux-gnu/rustup-init" \
    && echo "${RUSTUP_INIT_SHA256}  /tmp/rustup-init" | sha256sum --check --status \
    && chmod 0755 /tmp/rustup-init \
    && /tmp/rustup-init --default-toolchain none --profile minimal -y \
    && rustup toolchain install "$(awk -F '"' '/^channel / { print $2 }' rust-toolchain.toml)" --profile minimal \
        --component clippy --component rustfmt \
    && cargo install cargo-nextest --version "${CARGO_NEXTEST_VERSION}" --locked

COPY --chown=styrhous:styrhous Cargo.toml Cargo.lock ./
COPY --chown=styrhous:styrhous crates/styrhous/Cargo.toml crates/styrhous/build.rs ./crates/styrhous/
COPY --chown=styrhous:styrhous crates/components/Cargo.toml ./crates/components/

# Compile the dependency graph in a cacheable layer. The real checkout mounted
# at /workspace replaces only these placeholders; its dependencies remain in
# CARGO_TARGET_DIR until Cargo.toml, Cargo.lock, or the toolchain changes.
RUN mkdir --parents crates/styrhous/src crates/styrhous/benches crates/components/src \
    && printf '%s\n' 'pub fn dependency_cache_placeholder() {}' > crates/styrhous/src/lib.rs \
    && printf '%s\n' 'fn main() {}' > crates/styrhous/src/main.rs \
    && printf '%s\n' 'fn main() {}' > crates/styrhous/benches/log_viewer.rs \
    && printf '%s\n' 'pub fn dependency_cache_placeholder() {}' > crates/components/src/lib.rs \
    && cargo build --workspace --all-targets --locked \
    && cargo clean --package components --package styrhous
